# Perundhu Production Environment Configuration
# Copy this file to terraform.tfvars and update values

# GCP Configuration
project_id = "perundhu-prod-001"
region     = "asia-south1"  # Database region
zone       = "asia-south1-a"

# Environment Configuration
environment = "production"
app_name    = "perundhu"

# Database Configuration - Production settings
db_version       = "MYSQL_8_0"
db_instance_tier = "db-n1-standard-1"  # Higher tier for production

# Notifications Configuration
notification_email = "ops@perundhu.com"  # Alert email address

# Domain Configuration
domain_name = "perundhu.com"
cloud_dns_zone_name = "perundhu-com"

# Container Image (managed by CI/CD)
container_image = "asia-south1-docker.pkg.dev/perundhu-prod-001/perundhu/backend:latest"
