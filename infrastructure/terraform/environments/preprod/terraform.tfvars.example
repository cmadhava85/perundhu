# Perundhu PreProd Environment Configuration
# Copy this file to terraform.tfvars and update values if needed

# GCP Configuration
project_id = "astute-strategy-406601"
region     = "asia-south1"
zone       = "asia-south1-a"

# Environment Configuration
environment = "preprod"
app_name    = "perundhu"

# Database Configuration
db_version       = "MYSQL_8_0"
db_instance_tier = "db-f1-micro"

# SQL Auto-Stop Configuration (Cost Optimization)
# Cloud Function automatically stops idle Cloud SQL instances
sql_autostop_idle_minutes              = 30                      # Stop after 30 min of inactivity
sql_autostop_dry_run_mode              = false                   # Set to true to test without stopping
sql_autostop_cron_schedule             = "*/30 * * * *"          # Run every 30 minutes
sql_autostop_schedule_interval_minutes = 30
sql_autostop_time_zone                 = "Asia/Kolkata"
sql_autostop_function_source_path      = "/tmp/sql-autostop.zip" # Update with actual path

