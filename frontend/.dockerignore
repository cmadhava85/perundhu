# Prevent local environment overrides from being copied into Docker builds
.env*.local

# Node modules (will be installed fresh in container)
node_modules

# Build artifacts (will be created in container)
dist

# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Testing
coverage
.nyc_output

# Misc
.cache
.temp
