# Production Environment Configuration for Perundhu
# Ensures all data comes from real database, not mocks/stubs

# API Configuration - Nginx Proxy (Cost Optimized)
# API proxied through www.perundhu.com/api/* via nginx (single domain, single SSL cert)
# This saves ~$18/month by eliminating separate api.perundhu.com domain mapping
VITE_API_URL=/api
VITE_API_BASE_URL=/api
VITE_API_KEY=production-api-key

# Application Version
VITE_APP_VERSION=1.0.6

# Security Configuration
VITE_SECURITY_ENABLED=true
VITE_RATE_LIMIT_ENABLED=true
VITE_ENCRYPTION_ENABLED=true

# Feature Flags - All Real Features Enabled
VITE_FEATURE_TRACKING=true
VITE_FEATURE_REWARDS=true
VITE_FEATURE_ANALYTICS=true
VITE_FEATURE_CONTRIBUTIONS=true
VITE_FEATURE_ADMIN=true

# CRITICAL: Disable Mock Data - Force Real Database Usage
VITE_MOCK_API=false
VITE_USE_MOCK_DATA=false
VITE_OFFLINE_MODE=false

# VITE_DEBUG_MODE=false
# NOTE: NODE_ENV is automatically set by Vite based on the build command
# Do not set NODE_ENV in .env files - use 'npm run build' for production

# Authentication - Real OAuth2 
VITE_AUTH_PROVIDER=oauth2
VITE_JWT_ISSUER=https://perundhu.com
VITE_JWT_AUDIENCE=perundhu-api

# Google AdSense - Bus Results Ad
REACT_APP_GOOGLE_AD_CLIENT=ca-pub-9475468169056134
REACT_APP_AD_SLOT_RESULTS=ca-pub-9475468169056134/7968728507

# Map Configuration
# IMPORTANT: VITE_GOOGLE_MAPS_API_KEY is set during CI/CD build from secrets
VITE_GOOGLE_MAPS_API_KEY=
VITE_PERUNDHU_MAP_ID=84c44fb9bb8233a89e4a63a8
VITE_ENABLE_MAP=true

# Contribution Methods
VITE_ENABLE_PASTE_CONTRIBUTION=true
VITE_ENABLE_IMAGE_CONTRIBUTION=true
VITE_ENABLE_MANUAL_CONTRIBUTION=true

# Security Configuration (strict for production)
VITE_HONEYPOT_ENABLED=true
VITE_RECAPTCHA_ENABLED=true
VITE_RECAPTCHA_ENTERPRISE=true
VITE_RECAPTCHA_SITE_KEY=6Lf-qkAsAAAAAMsufKTr2pb6mh9_OSEYcDyl7juE
VITE_API_KEY_ENABLED=false
VITE_PUBLIC_API_KEY=