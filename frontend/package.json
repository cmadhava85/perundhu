{
  "name": "perundhu",
  "private": true,
  "version": "1.0.42",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "VITE_API_URL=http://localhost:8080 VITE_API_BASE_URL=http://localhost:8080 vite",
    "dev:preprod": "vite --mode preprod",
    "build": "tsc -b && vite build",
    "build:analyze": "tsc -b && vite build && open dist/stats.html",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "preview": "vite preview",
    "test": "./run-tests-safe.sh",
    "test:raw": "NODE_OPTIONS='--max-old-space-size=4096 --expose-gc' vitest run --no-coverage",
    "test:fast": "NODE_OPTIONS='--max-old-space-size=4096 --expose-gc' vitest run --no-coverage --exclude='**/{SearchResults,BusTracker,CombinedMap}*.test.tsx'",
    "test:sequential": "NODE_OPTIONS='--max-old-space-size=3072 --expose-gc' vitest run --no-coverage --pool.forks.singleFork=true --pool.forks.maxForks=1 --max-concurrency=1 --exclude='**/{SearchResults,BusTracker,CombinedMap,RouteMap,RouteDetails,AdminDashboard,BusDataUpload,UserContributions,Analytics,MapView,AdminRouteDetails}*.test.tsx'",
    "test:critical": "NODE_OPTIONS='--max-old-space-size=4096 --expose-gc' vitest run --no-coverage --pool.forks.singleFork=true --pool.forks.maxForks=1 --max-concurrency=1 src/components/{Header,Footer,ErrorBoundary,Loading}.test.tsx src/utils/*.test.ts src/hooks/*.test.ts",
    "test:batched": "./run-tests-batched.sh",
    "test:selective": "./run-tests-selective.sh",
    "test:single": "NODE_OPTIONS='--max-old-space-size=4096 --expose-gc' vitest run --no-coverage --reporter=verbose",
    "test:heavy": "NODE_OPTIONS='--max-old-space-size=12288 --expose-gc' vitest run --no-coverage --reporter=verbose",
    "test:watch": "NODE_OPTIONS='--max-old-space-size=6144 --disable-warning=MaxListenersExceededWarning --expose-gc' vitest --watch",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=8192 --disable-warning=MaxListenersExceededWarning --expose-gc' vitest --coverage",
    "test:ui": "NODE_OPTIONS='--max-old-space-size=6144 --disable-warning=MaxListenersExceededWarning' vitest --ui",
    "generate:types": "openapi-typescript http://localhost:8080/v3/api-docs -o src/types/api-generated.d.ts",
    "type-check": "tsc --noEmit",
    "quality": "npm run format:check && npm run lint && npm run type-check",
    "test:e2e": "npm run dev & sleep 5 && npx playwright test; kill %1",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:debug": "npx playwright test --debug",
    "test:e2e:chromium": "npx playwright test --project=chromium",
    "test:e2e:mobile": "npx playwright test --project=mobile",
    "test:e2e:report": "npx playwright show-report"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.6",
    "@tanstack/react-query": "^5.90.10",
    "@tanstack/react-query-devtools": "^5.90.2",
    "axios": "^1.7.7",
    "axios-retry": "^4.5.0",
    "date-fns": "^3.6.0",
    "i18next": "^25.4.1",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^2.6.1",
    "idb": "^8.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.445.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^15.0.2",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^6.26.2",
    "react-window": "^1.8.11",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.7.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^2.1.2",
    "autoprefixer": "^10.4.20",
    "axios-mock-adapter": "^2.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.8.29",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.10.0",
    "happy-dom": "^20.3.4",
    "identity-obj-proxy": "^3.0.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.47",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "sharp": "^0.33.5",
    "svgo": "^4.0.1",
    "tailwindcss": "^3.4.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^7.2.4",
    "vite-plugin-image-optimizer": "^1.1.8",
    "vitest": "^2.1.2",
    "wait-on": "^9.0.3"
  }
}
