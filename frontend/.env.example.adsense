# Google AdSense Configuration
# Get your Publisher ID from: https://www.google.com/adsense/start/

# Your Google Publisher ID (ca-pub-xxxxxxxxxxxxxxxx)
# Replace with your actual publisher ID
REACT_APP_GOOGLE_AD_CLIENT=ca-pub-xxxxxxxxxxxxxxxx

# Ad Slot IDs - one for each placement
# Get these from Google AdSense dashboard

# Between search results (336x280 medium rectangle recommended)
REACT_APP_AD_SLOT_RESULTS=ca-pub-xxxxxxxxxxxxxxxx/xxxxxxxx1

# Right sidebar (300x600 vertical recommended)
REACT_APP_AD_SLOT_SIDEBAR=ca-pub-xxxxxxxxxxxxxxxx/xxxxxxxx2

# Footer section (728x90 leaderboard recommended)
REACT_APP_AD_SLOT_FOOTER=ca-pub-xxxxxxxxxxxxxxxx/xxxxxxxx3

# Above search form (728x90 leaderboard recommended)
REACT_APP_AD_SLOT_ABOVE=ca-pub-xxxxxxxxxxxxxxxx/xxxxxxxx4
